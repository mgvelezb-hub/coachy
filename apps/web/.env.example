# ---------------------------------------------------------------------------
# Coachy — variables de entorno. Copia a .env.local y rellena.
# NUNCA subas .env.local al repo (está en .gitignore).
# ---------------------------------------------------------------------------

# --- Supabase (Auth + Storage) --------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...anon...key"
# Solo servidor. Nunca la expongas al cliente ni la commitees.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service_role...key"

# --- Base de datos (Prisma) ------------------------------------------------
# Producción (Supabase): Project Settings -> Database -> Connection string
#   DATABASE_URL  = pooler (Transaction, puerto 6543) + ?pgbouncer=true
#   DIRECT_URL    = conexión directa (puerto 5432), usada por `prisma migrate`
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Desarrollo local (PostgreSQL 17 en localhost):
DATABASE_URL="postgresql://vpconsulting@localhost:5433/coachy_dev?schema=public"
DIRECT_URL="postgresql://vpconsulting@localhost:5433/coachy_dev?schema=public"

# --- IA --------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
# Modelos de Coachy. Opcionales: si no los pones, usa estos mismos.
# COACHY_COMPOSE_MODEL="claude-sonnet-5"
# COACHY_VISION_MODEL="claude-sonnet-5"
# COACHY_FAST_MODEL="claude-haiku-4-5"

# --- App -------------------------------------------------------------------
# Emails (separados por coma) que reciben rol ADMIN al registrarse.
ADMIN_EMAILS="tu-email@ejemplo.com"
# Análisis de fotos con IA. Fase 1 lo deja apagado.
VISION_ENABLED="false"
# Las decisiones del motor requieren aprobación del admin antes de publicarse.
REQUIRE_APPROVAL="true"

# --- Recordatorios ---------------------------------------------------------
# Protege /api/cron/* y /api/coachy/run. Sin esta variable esos endpoints
# responden 503: mejor un cron muerto que un endpoint abierto.
# Genera uno con: openssl rand -hex 32
CRON_SECRET=""
# Correo (opcional). Sin llave, los avisos existen solo dentro de la app.
RESEND_API_KEY=""
RESEND_FROM="Coachy <coachy@tu-dominio.com>"
