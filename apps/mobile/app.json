{
  "expo": {
    "name": "Holy Gains",
    "slug": "holy-gains",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "holygains",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.holygains.app",
      "supportsTablet": false,
      "appleTeamId": "Y2AN8V2K8H",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.holygains.app"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A0F12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.holygains.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A0F12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Holy Gains necesita acceso a tus fotos para subir tus fotos de referencia del objetivo."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Holy Gains lee tus pasos, sueño y frecuencia cardiaca para ajustar tu gasto calórico y avisarte cuando dormiste poco.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
