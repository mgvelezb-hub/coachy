{
  "expo": {
    "name": "Holy Gains",
    "slug": "holy-gains",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "holygains",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.holygains.app",
      "supportsTablet": false,
      "appleTeamId": "Y2AN8V2K8H",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.holygains.app"
        ]
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Holy Gains usa Face ID para abrir tus fotos de progreso, que están guardadas detrás de tu clave."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A0F12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.holygains.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6B1F2E"
        }
      ],
      "expo-sqlite",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Holy Gains necesita acceso a tus fotos para subir tus fotos de referencia del objetivo."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Holy Gains lee tus pasos, sueño y frecuencia cardiaca para ajustar tu gasto calórico y avisarte cuando dormiste poco.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Holy Gains usa Face ID para abrir tus fotos de progreso, que están guardadas detrás de tu clave."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
